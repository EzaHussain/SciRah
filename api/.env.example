# Copy to api/.env and fill in. Never commit the real file.
PORT=4000
# Comma-separated list of allowed frontend origins (CORS + Google sign-in redirect check)
WEB_ORIGIN=http://localhost:3000
# Contact email sent to OpenAlex / Crossref / NCBI for their "polite pool" (recommended)
CONTACT_EMAIL=

# ---- Database: any PostgreSQL 13+ (tables are created automatically on start-up) ----
# Local:   postgres://postgres:postgres@localhost:5432/scirah
# Neon / Railway / Render: paste the connection string they give you.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/scirah
# auto = TLS for hosted databases, none for localhost. Force with "require" or "disable".
DATABASE_SSL=auto

# ---- Accounts ----
# Long random secret that signs sign-in sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
SESSION_DAYS=30
# Google sign-in: OAuth client (type "Web application") from console.cloud.google.com.
# Authorized redirect URI: http://localhost:3000/auth/google/callback  (+ your production URL)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Researchers claim their profile (adds patents / graduated students to their SciRah Score) by
# signing in with ORCID. Register a free "public API" client at https://orcid.org/developer-tools
# with redirect URI http://localhost:3000/auth/orcid/callback (+ your production URL).
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
# ORCID_BASE_URL=https://sandbox.orcid.org   # for testing with ORCID's sandbox

# Email (university-email verification codes for researchers), sent with Nodemailer over SMTP.
# Gmail: turn on 2-Step Verification, create an "App password" (myaccount.google.com/apppasswords), then:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Railway blocks SMTP on its Free/Hobby plans. There, use Resend's HTTP API instead (https://resend.com):
# RESEND_API_KEY=

# Emails (comma-separated) that can review manually added papers; their own additions are approved directly.
ADMIN_EMAILS=

# Optional: Redis for caching. Without it the API uses an in-memory cache.
REDIS_URL=

# Scholarly APIs
OPENALEX_API_KEY=             # optional (higher daily allowance)
SEMANTIC_SCHOLAR_API_KEY=     # free signup; without it S2 is frequently rate-limited
CORE_API_KEY=                 # free signup; CORE is skipped without it
NCBI_API_KEY=                 # optional (PubMed 10 req/s instead of 3)

# AI summaries + voice-over (both use OpenAI; no Google Cloud needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_TTS_MODEL=gpt-4o-mini-tts   # falls back to tts-1 automatically
OPENAI_TTS_VOICE=marin             # alloy, coral, nova, sage, marin, cedar…
OPENAI_IMAGE_MODEL=gpt-image-1     # AI illustrations; falls back to dall-e-3 if unavailable
AI_DAILY_LIMIT=40             # per-user cap on paid AI calls per day

# Alerts / notifications
ALERTS_ENABLED=true
ALERTS_INTERVAL_MINUTES=30    # how often the background checker runs
ALERT_CHECK_HOURS=6           # how often each followed topic is re-checked
MAX_AUTO_ALERTS=25            # searches auto-followed per user
